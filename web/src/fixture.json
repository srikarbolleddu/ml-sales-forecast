{
 "schema": {
  "contract": "ml-demo-kit/v1",
  "title": "How many units will this product sell next month?",
  "description": "Change a product's recent sales, price or the month being forecast and see how a gradient-boosting forecast, and the inputs driving it, change.",
  "task": "regression",
  "target": "units_next_month",
  "groups": [
   {
    "id": "history",
    "label": "Recent sales"
   },
   {
    "id": "product",
    "label": "Product"
   },
   {
    "id": "timing",
    "label": "Timing"
   }
  ],
  "fields": [
   {
    "name": "units_last_month",
    "label": "Units sold last month",
    "kind": "number",
    "group": "history",
    "help": "Units of this product sold in the most recent full month.",
    "optional": false,
    "min": 0,
    "max": 20000,
    "step": 1,
    "unit": "units"
   },
   {
    "name": "units_2_months_ago",
    "label": "Units sold 2 months ago",
    "kind": "number",
    "group": "history",
    "help": "Units sold the month before last.",
    "optional": false,
    "min": 0,
    "max": 20000,
    "step": 1,
    "unit": "units"
   },
   {
    "name": "units_3_months_ago",
    "label": "Units sold 3 months ago",
    "kind": "number",
    "group": "history",
    "help": "Units sold three months ago.",
    "optional": false,
    "min": 0,
    "max": 20000,
    "step": 1,
    "unit": "units"
   },
   {
    "name": "units_same_month_last_year",
    "label": "Units sold in that month last year",
    "kind": "number",
    "group": "history",
    "help": "Units sold in the forecast month one year earlier. Leave empty if the product wasn't on sale then.",
    "optional": true,
    "min": 0,
    "max": 20000,
    "step": 1,
    "unit": "units"
   },
   {
    "name": "customers_last_month",
    "label": "Customers last month",
    "kind": "number",
    "group": "history",
    "help": "Distinct customers who bought the product last month.",
    "optional": false,
    "min": 0,
    "max": 1000,
    "step": 1,
    "unit": "customers"
   },
   {
    "name": "unit_price",
    "label": "Unit price",
    "kind": "number",
    "group": "product",
    "help": "Typical selling price per unit (last known).",
    "optional": false,
    "min": 0.01,
    "max": 100,
    "step": 0.01,
    "unit": "GBP"
   },
   {
    "name": "price_change_pct",
    "label": "Price change over 3 months",
    "kind": "number",
    "group": "product",
    "help": "Change in typical price compared with three months earlier.",
    "optional": false,
    "min": -90,
    "max": 300,
    "step": 0.1,
    "unit": "%"
   },
   {
    "name": "months_on_sale",
    "label": "Months on sale",
    "kind": "number",
    "group": "product",
    "help": "Months since the product's first sale (in this dataset).",
    "optional": false,
    "min": 1,
    "max": 24,
    "step": 1,
    "unit": "months"
   },
   {
    "name": "forecast_month",
    "label": "Forecast month",
    "kind": "category",
    "group": "timing",
    "help": "The month being forecast. Gift sales peak before Christmas.",
    "optional": false,
    "options": [
     {
